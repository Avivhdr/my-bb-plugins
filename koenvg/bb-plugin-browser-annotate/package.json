{
  "name": "bb-plugin-browser-annotate",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37 <0.7"
  },
  "bb": {
    "name": "Browser Annotate",
    "description": "Mark areas in a Browser tab, add comments, and send each one to the agent as a cropped screenshot.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "lint": "bun run --cwd .. lint bb-plugin-browser-annotate",
    "lint:fix": "bun run --cwd .. lint:fix bb-plugin-browser-annotate",
    "format": "bun run --cwd .. format bb-plugin-browser-annotate",
    "format:check": "bun run --cwd .. format:check bb-plugin-browser-annotate",
    "test": "vitest run",
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bb plugin build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.1",
    "hono": "^4.11.9",
    "jsdom": "^28.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
